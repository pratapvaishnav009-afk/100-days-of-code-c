//Q 27 Write a program to print the sum of the first n odd numbers.//
#include <stdio.h>

int main() {
    int n, sum = 0;

    printf("Enter n: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        sum = sum + (2 * i - 1);
    }

    printf("Sum of first %d odd numbers = %d", n, sum);

    return 0;
}
//Q 28 Write a program to print the product of even numbers from 1 to n.//
#include <stdio.h>

int main() {
    int n, product = 1;

    printf("Enter n: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i % 2 == 0) {
            product = product * i;
        }
    }

    printf("Product of even numbers = %d", product);

    return 0;
}
