//Q 1Write a program to input two numbers and display their sum.//
#include <stdio.h>

int main() {
    double num1, num2; // Using double to handle integers and decimals

    printf("Enter two numbers: ");

    // Validate that exactly two numbers are entered
    if (scanf("%lf %lf", &num1, &num2) != 2) {
        printf("Invalid input. Please enter numeric values only.\n");
        return 1; // Exit with error code
    }

    double sum = num1 + num2;

    printf("Sum of %.2lf and %.2lf is: %.2lf\n", num1, num2, sum);

    return 0; // Successful execution
}
//Q2 Write a program to input two numbers and display their sum, difference, product, and quotient.//
#include <stdio.h>

int main() {
    double num1, num2; // Using double to handle decimal inputs
    double sum, difference, product, quotient;

    // Prompt user for input
    printf("Enter two numbers: ");

    // Validate input
    if (scanf("%lf %lf", &num1, &num2) != 2) {
        printf("Invalid input. Please enter numeric values.\n");
        return 1; // Exit with error
    }

    // Perform calculations
    sum = num1 + num2;
    difference = num1 - num2;
    product = num1 * num2;

    // Display results
    printf("\nResults:\n");
    printf("Sum: %.2lf\n", sum);
    printf("Difference: %.2lf\n", difference);
    printf("Product: %.2lf\n", product);

    // Handle division by zero
    if (num2 != 0) {
        quotient = num1 / num2;
        printf("Quotient: %.2lf\n", quotient);
    } else {
        printf("Quotient: Undefined (division by zero)\n");
    }

    return 0; // Successful execution
}
