// Q69 (Arrays (1D))
// Find the second largest element in an array.

#include <stdio.h>

int main()
{
    int a[100], n, i;
    int largest, second;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    largest = a[0];
    second = 0;

    for(i = 1; i < n; i++)
    {
        if(a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if(a[i] < largest)
        {
            if(second == 0 || a[i] > second)
            {
                second = a[i];
            }
        }
    }

    if(second == 0)
    {
        printf("Second largest element does not exist");
    }
    else
    {
        printf("Second largest element = %d", second);
    }

    return 0;
}


// Q70 (Arrays (1D))
// Rotate an array to the right by k positions.

#include <stdio.h>

int main()
{
    int a[100], n, i, k, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter number of rotations: ");
    scanf("%d", &k);

    if(n <= 0)
    {
        printf("Invalid array size");
        return 0;
    }

    k = k % n;

    for(i = 0; i < k; i++)
    {
        temp = a[n - 1];

        for(int j = n - 1; j > 0; j--)
        {
            a[j] = a[j - 1];
        }

        a[0] = temp;
    }

    printf("Array after rotation:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    return 0;
}
