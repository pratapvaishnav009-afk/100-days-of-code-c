/* Q51 (Nested Loops without Arrays/Strings)
Write a program to print the following pattern:

    5
   45
  345
 2345
12345
*/

#include <stdio.h>

int main()
{
    int i, j;

    for (i = 1; i <= 5; i++)
    {
        for (j = 1; j <= 5 - i; j++)
        {
            printf(" ");
        }

        for (j = 6 - i; j <= 5; j++)
        {
            printf("%d", j);
        }

        printf("\n");
    }

    return 0;
}


/* Q52 (Nested Loops without Arrays/Strings)
Write a program to print the following pattern:

*
 
*
*
*

*
*
*
*
*

*
*
*

*
*/

#include <stdio.h>

int main()
{
    int i, j, rows;

    for (i = 1; i <= 5; i++)
    {
        if (i == 1 || i == 5)
            rows = 1;
        else if (i == 2 || i == 4)
            rows = 3;
        else
            rows = 5;

        for (j = 1; j <= rows; j++)
        {
            printf("*\n");
        }

        printf("\n");
    }

    return 0;
}
