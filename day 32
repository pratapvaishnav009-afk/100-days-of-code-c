/* Q63 (Arrays (1D))
Question: Merge two arrays.
*/

#include <stdio.h>

int main()
{
    int a[100], b[100], c[200];
    int n1, n2, i;

    printf("Enter the size of first array: ");
    scanf("%d", &n1);

    printf("Enter elements of first array:\n");

    for (i = 0; i < n1; i++)
    {
        scanf("%d", &a[i]);
        c[i] = a[i];
    }

    printf("Enter the size of second array: ");
    scanf("%d", &n2);

    printf("Enter elements of second array:\n");

    for (i = 0; i < n2; i++)
    {
        scanf("%d", &b[i]);
        c[n1 + i] = b[i];
    }

    printf("Merged array:\n");

    for (i = 0; i < n1 + n2; i++)
    {
        printf("%d ", c[i]);
    }

    return 0;
}


/* Q64 (Arrays (1D))
Question: Find the digit that occurs the most times in an integer number.
*/

#include <stdio.h>

int main()
{
    int n, digit, i;
    int count[10] = {0};
    int max = 0, result = 0;

    printf("Enter an integer number: ");
    scanf("%d", &n);

    if (n < 0)
    {
        n = -n;
    }

    if (n == 0)
    {
        count[0] = 1;
    }

    while (n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    for (i = 0; i < 10; i++)
    {
        if (count[i] > max)
        {
            max = count[i];
            result = i;
        }
    }

    printf("Digit occurring most times = %d", result);
    printf("\nFrequency = %d", max);

    return 0;
}
